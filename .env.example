# Spec v0.9 muc 47e — tach rieng theo tung Vercel environment (Preview/Production)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY

# KHONG BAO GIO them tien to NEXT_PUBLIC_ vao bien nay.
# Chi duoc doc trong lib/supabase/admin.ts (co 'server-only').
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Dung cho scripts/seed-first-admin.ts va scripts/export-to-csv.ts
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Ky session cho tai khoan "local" (username/password tu dang ky, khong qua
# Supabase Auth) - lib/auth/localSession.ts. Chuoi ngau nhien, it nhat 32 ky
# tu, giu bi mat nhu SERVICE_ROLE_KEY. Doi gia tri nay se dang xuat toan bo
# tai khoan local dang dang nhap.
LOCAL_AUTH_SECRET=
